#!/bin/sh

protected_branch="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected_branch" ]; then
    echo ""
    echo "ERROR: Direct pushes to 'main' are blocked."
    echo "Create a feature branch and open a Pull Request instead:"
    echo "  git checkout -b feat/your-branch-name"
    echo "  git push -u origin feat/your-branch-name"
    echo ""
    exit 1
  fi
done

exit 0
